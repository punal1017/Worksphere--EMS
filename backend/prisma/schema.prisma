// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  role   Role   @default(EMPLOYEE)
  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance          Attendance[]
  leaves              Leave[] @relation("LeaveRequester")
  hrApprovedLeaves    Leave[] @relation("HRApprover")
  adminApprovedLeaves Leave[] @relation("AdminApprover")


    resetTokenHash   String?   @unique
  resetTokenExpiry DateTime?

  dateOfBirth DateTime?
  address     String?
  phoneNumber String?
}

model Attendance {
  id       Int      @id @default(autoincrement())
  userId   Int
  date     DateTime
  checkIn  DateTime?
  checkOut DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model Leave {
  id Int @id @default(autoincrement())

  userId    Int
  leaveType String
  startDate DateTime
  endDate   DateTime
  reason    String

  status LeaveStatus @default(PENDING_HR)

  hrApprovedBy  Int?
  hrApprovedAt  DateTime?
  adminApprovedBy Int?
  adminApprovedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester     User  @relation("LeaveRequester", fields: [userId], references: [id])
  hrApprover    User? @relation("HRApprover", fields: [hrApprovedBy], references: [id])
  adminApprover User? @relation("AdminApprover", fields: [adminApprovedBy], references: [id])
}

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum Status {
  ACTIVE
  INACTIVE
}

enum LeaveStatus {
  PENDING_HR
  HR_REJECTED
  PENDING_ADMIN
  ADMIN_REJECTED
  APPROVED
  CANCELLED
}