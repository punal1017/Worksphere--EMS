// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  role   Role   @default(EMPLOYEE)
  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance          Attendance[]
  leaves              Leave[]      @relation("LeaveRequester")
  hrApprovedLeaves    Leave[]      @relation("HRApprover")
  adminApprovedLeaves Leave[]      @relation("AdminApprover")

  resetTokenHash   String?   @unique
  resetTokenExpiry DateTime?

  dateOfBirth DateTime?
  address     String?
  phoneNumber String?
  profilePicture String?

  posts         Post[]         @relation("PostAuthor")
  postReactions PostReaction[]
}

model Attendance {
  id       Int       @id @default(autoincrement())
  userId   Int
  date     DateTime
  checkIn  DateTime?
  checkOut DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id])
  sessions AttendanceSession[]

  @@unique([userId, date])
}

model AttendanceSession {
  id           Int       @id @default(autoincrement())
  attendanceId Int
  checkIn      DateTime
  checkOut     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId, checkIn])
}

model Leave {
  id Int @id @default(autoincrement())

  userId    Int
  leaveType String
  startDate DateTime
  endDate   DateTime
  reason    String

  status LeaveStatus @default(PENDING_HR)

  hrApprovedBy    Int?
  hrApprovedAt    DateTime?
  adminApprovedBy Int?
  adminApprovedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester     User  @relation("LeaveRequester", fields: [userId], references: [id])
  hrApprover    User? @relation("HRApprover", fields: [hrApprovedBy], references: [id])
  adminApprover User? @relation("AdminApprover", fields: [adminApprovedBy], references: [id])
}

model Post {
  id        Int      @id @default(autoincrement())
  content   String?
  imageUrl  String?

  authorId  Int
  author    User     @relation("PostAuthor", fields: [authorId], references: [id])

  reactions PostReaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
}

model PostReaction {
  id        Int               @id @default(autoincrement())

  postId    Int
  userId    Int
  type      PostReactionType

  post      Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, userId])
  @@index([userId])
}

enum PostReactionType {
  LIKE
  DISLIKE
}

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum Status {
  ACTIVE
  INACTIVE
}

enum LeaveStatus {
  PENDING_HR
  HR_REJECTED
  PENDING_ADMIN
  ADMIN_REJECTED
  APPROVED
  CANCELLED
}
